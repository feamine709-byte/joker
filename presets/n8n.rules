# V0.5-Joker n8n & Local Webhook Automation Preset
L1 ENV_CLEAR * 1
L1 RATE_LIMIT 120
L1 QUOTA 65536
L1 TIMEOUT 20
L1 RETRY 2
L1 BREAK 3
L1 REDACT sk-* 1
L1 REDACT ghp_* 1
L1 REDACT Bearer_* 1
L1 DENY "rm -rf" 1
L1 STOP 401_UNAUTHORIZED 1
L1 STOP 403_FORBIDDEN 1
L1 AUDIT * 1
L2 ALLOW webhook 1
L2 ROUTE webhook 1
L2 PREFER webhook 15
L2 FALLBACK retry_queue 1
L2 LOG * 1
